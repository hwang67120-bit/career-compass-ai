# 서버 테스트 배포용 환경변수 예시. 실제 값 없이 이름·자리표시자만.
# 실제 deploy/.env는 Git에서 제외한다(.gitignore). 값은 서버에서만 채운다.

# --- 공통 비밀값 (Java·Python 같은 값) ---
INTERNAL_SERVICE_TOKEN=

# --- DB (Postgres 컨테이너) ---
DB_NAME=career_compass
DB_USERNAME=career_compass
DB_PASSWORD=

# --- Java: 외부 연동 ---
PUBLIC_EMPLOYMENT_API_SERVICE_KEY=
# GitHub OAuth App(로그인). github.com/settings/developers 에서 앱 생성 후 값 입력.
# Authorization callback URL을 서버 주소로 설정해야 로그인 됨:
#   http://<서버 접근주소>:8080/login/oauth2/code/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub PAT(선택, 저장소 분석용). 없으면 비인증(60회/시간)이라 반복 분석 시 레이트
# 리밋에 막힌다. github.com/settings/tokens 에서 발급(public_repo 또는 공개 저장소
# 읽기 권한이면 충분). 있으면 5000회/시간.
GITHUB_API_TOKEN=

# --- Python: Ollama (이미지 미포함, 별도 모델 머신) ---
# 서버가 접근 가능한 모델 머신 주소. localhost 아님. 실제 주소는 여기 안 적고 서버 .env에만.
OLLAMA_BASE_URL=http://MODEL_MACHINE_HOST:11434
# 모델 평가 결론(docs/current-work.md 2026-08-03): core(직무명·기술)는 qwen2.5가 최고(86%),
# 담당업무는 exaone3.5가 정상(qwen2.5는 담당업무 근거를 안 만듦). 두 모델을 바꿔 쓰지 말 것.
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_JOB_POSTING_RESPONSIBILITY_MODEL=exaone3.5:latest
OLLAMA_EVIDENCE_JUDGE_MODEL=qwen2.5:latest
OLLAMA_PROJECT_RESPONSIBILITY_MODEL=qwen2.5:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# --- Python: Gemini 폴백 ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# --- Python: 입력 제한 ---
JOB_POSTING_EXTRACTION_MAX_TEXT_LENGTH=2000

# --- 배포 노출 범위 ---
# 브라우저 접근용 Java 바인딩. 기본 127.0.0.1(로컬만). 내부망 접근은 LAN IP + 방화벽.
JAVA_BIND_ADDRESS=127.0.0.1

# --- 시연(데모) 토글 ---
# 공공 API 데이터가 개발 직무에 부적합함을 확인함(2026-08-18, 2008년 행정 공고).
# 파이프라인 전체를 기술 콘텐츠 대표 공고로 시연하려면 아래 둘을 함께 켠다.
# 평소(실데이터 연동 검증)에는 주석 처리해 기본값(prod / public-employment)을 쓴다.
#SPRING_PROFILES_ACTIVE=prod,demo
#JOB_SEARCH_PROVIDER=dev-sample
