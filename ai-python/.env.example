GEMINI_API_KEY=

# 확인 필요: 사용할 Ollama 모델 이름 (채용공고 직무명·기술 추출용, 예: exaone3.5:latest).
# 2026-08-11 fixture 평가(evaluation/job_posting_model_comparison.py)에서 core 추출
# 통과율이 exaone3.5 76% vs qwen2.5 35%였고, 같은 날 실제 공공기관 채용공고에서도
# qwen2.5가 core를 전부 빈 값으로 반환하는 게 재현됐다 — exaone3.5를 권장한다.
OLLAMA_MODEL=

# 채용공고 "담당 업무"만 추출하는 별도 호출 전용 모델 — OLLAMA_MODEL과 다른 모델을
# 쓴다(예: qwen2.5:latest). 2026-08-03 확인: qwen2.5는 이 호출에서 evidence를 계속
# 못 채웠고(4회+ 재현), exaone3.5는 6/6 성공했다 — 그래서 원래는 반대로 배정했다.
# 2026-08-11 core 평가 결과로 배정을 맞바꿨다. docs/current-work.md 참고, 확인 필요(표본 작음)
OLLAMA_JOB_POSTING_RESPONSIBILITY_MODEL=

# 선택: 기본값 http://127.0.0.1:11434. 다른 주소를 쓸 때만 지정한다.
# OLLAMA_BASE_URL=

# Gemini API는 제거하지 않는다. Ollama 실패 시 폴백과 제한적인 교차검증에 사용한다.
# 상시 병행 호출은 하지 않는다. 확인 필요: 사용할 Gemini 분석 모델 이름
GEMINI_MODEL=

# MVP 분석에서는 임베딩을 호출하지 않는다. 기존 평가 재현용 Ollama 임베딩 모델 이름
OLLAMA_EMBEDDING_MODEL=

# MVP 분석에서는 임베딩을 호출하지 않는다. Gemini API 제거가 아닌 기존 평가 재현용 설정
GEMINI_EMBEDDING_MODEL=

# 확인 필요: Java와 공유하는 내부 서비스 인증 토큰 (충분히 길고 무작위한 값)
INTERNAL_SERVICE_TOKEN=

# 확인 필요: 채용공고 계약이 제안 상태라 임시값. 텍스트 최대 길이(문자 수)
JOB_POSTING_EXTRACTION_MAX_TEXT_LENGTH=
