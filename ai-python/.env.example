GEMINI_API_KEY=

# 확인 필요: 사용할 Ollama 모델 이름 (채용공고 구조화 추출용, 예: qwen2.5:latest)
OLLAMA_MODEL=

# 이력서 구조화 추출 전용 모델. evaluation/model_comparison.py로 평가한 결과
# exaone3.5:latest 채택(100% 통과, 가장 빠름) — docs/architecture/llm-providers.md 참고
OLLAMA_RESUME_MODEL=

# 선택: 기본값 http://127.0.0.1:11434. 다른 주소를 쓸 때만 지정한다.
# OLLAMA_BASE_URL=

# 확인 필요: 사용할 Gemini 모델 이름 (예: gemini-2.5-flash)
GEMINI_MODEL=

# 확인 필요: 사용할 Ollama 임베딩 모델 이름 (예: nomic-embed-text:latest) — 실험 결과 한국어 도메인 구분력이 낮았음, docs/architecture/embedding-similarity.md 참고
OLLAMA_EMBEDDING_MODEL=

# 확인 필요: 사용할 Gemini 임베딩 모델 이름 (예: models/gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=

# 확인 필요: Java와 공유하는 내부 서비스 인증 토큰 (충분히 길고 무작위한 값)
INTERNAL_SERVICE_TOKEN=

# 확인 필요: Java의 업로드 제한과 맞춰야 하는 PDF 최대 크기(바이트)
DOCUMENT_EXTRACTION_MAX_PDF_SIZE_BYTES=
