  "item": [
    {
      "name": "서버 상태 확인",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('서버가 200을 반환한다', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('서버 상태가 UP이다', function () {",
